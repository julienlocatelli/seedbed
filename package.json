{
  "name": "seedbed",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "setup": "bun scripts/setup.ts",
    "test": "bun test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "lint:gherkin": "gherkin-lint -c .claude/skills/specification/lint/gherkin-lintrc.json",
    "lint:story": "markdownlint-cli2 --config .claude/skills/specification/lint/.markdownlint-cli2.jsonc"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/bun": "1.3.14",
    "@types/node": "26.6.6",
    "eslint": "10.13.0",
    "gherkin-lint": "4.2.4",
    "globals": "17.13.0",
    "knip": "6.44.0",
    "markdownlint-cli2": "0.24.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  },
  "packageManager": "bun@1.3.14"
}
